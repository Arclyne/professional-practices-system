<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0" styleClass="root" stylesheets="@../styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.fei.presentation.DashboardController">

    <left>
        <VBox prefWidth="260.0" spacing="10.0" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>

            <Label styleClass="form-title" text="SGP - FEI">
                <VBox.margin>
                    <Insets bottom="10.0"/>
                </VBox.margin>
            </Label>

            <VBox spacing="2.0">
                <Label fx:id="systemUserNameLabel" text="Cargando..." styleClass="field-label" />
                <Label fx:id="systemUserRoleLabel" text="Rol: ..." textFill="#6b7280">
                    <font>
                        <Font size="12.0" />
                    </font>
                </Label>
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </VBox>

            <Separator opacity="0.5"/>

            <Label text="Menú Principal" textFill="#9CA3AF">
                <font>
                    <Font name="System Bold" size="11.0" />
                </font>
                <VBox.margin>
                    <Insets top="10.0" bottom="5.0"/>
                </VBox.margin>
            </Label>

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="secondary-button" text="Inicio" />

            <Button fx:id="navigateToMessagesButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleNavigateToMessagesAction" styleClass="secondary-button" text="Mensajes" />

            <Button fx:id="navigateToTemplatesButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleNavigateToTemplatesAction" styleClass="secondary-button" text="Generador de Plantillas"
                    visible="false" managed="false"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="systemLogoutButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleSystemLogoutAction" style="-fx-background-color: #FEF2F2; -fx-text-fill: #EF4444; -fx-border-color: #FCA5A5; -fx-border-radius: 8px; -fx-cursor: hand;"
                    text="Cerrar Sesión" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="dashboardMainContentArea" style="-fx-background-color: #FFFFFF;">
            <VBox alignment="CENTER" spacing="15.0">
                <Label styleClass="form-title" text="Bienvenido al Sistema de Gestión" />
                <Label text="Seleccione una acción para comenzar." textFill="#6b7280">
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </Label>

                <VBox alignment="CENTER" spacing="15.0" maxWidth="300.0">
                    <Button fx:id="navigateToRegisterCoordinatorButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterCoordinatorAction" styleClass="secondary-button" text="Registrar Coordinador"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToPractitionerManagementMenuButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToPractitionerManagementAction" styleClass="secondary-button" text="Gestión de Practicantes"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToRegisterProfessorButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterProfessorAction" styleClass="secondary-button" text="Gestión de Profesores"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToRegisterPeriodButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterPeriodAction" styleClass="secondary-button" text="Registrar Periodo"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToRegisterPracticeGroupButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterPracticeGroupAction" styleClass="secondary-button" text="Registrar Grupo de Prácticas"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToRegisterProjectButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterProjectAction" styleClass="secondary-button" text="Gestión de Proyectos"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToRegisterManagerButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterManagerAction" styleClass="secondary-button" text="Gestión de Encargados"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToRegisterOrganizationButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToRegisterOrganizationAction" styleClass="secondary-button" text="Gestión de Organizaciones"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToPractitionerProjectsButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToPractitionerProjectsAction" styleClass="secondary-button" text="Mis Proyectos"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToLogbookButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToLogbookAction" styleClass="secondary-button" text="Mis Actividades"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToReportGeneratorButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToReportsList" styleClass="secondary-button" text="Generar Reporte"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToEvaluateReportsButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToEvaluateReportsAction" styleClass="secondary-button" text="Evaluar Reportes"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToGradePractitionerButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToGradePractitionerAction" styleClass="secondary-button" text="Calificar Practicantes"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToProgressReportButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToProgressReportAction" styleClass="secondary-button" text="Reporte de Avance"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToGradeViewButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToGradeViewAction" styleClass="secondary-button" text="Mi Calificación"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToSelfEvaluationButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToSelfEvaluationAction" styleClass="secondary-button" text="Autoevaluación Final"
                            visible="false" managed="false"/>

                    <Button fx:id="navigateToReviewSelfEvaluationButton" maxWidth="1.7976931348623157E308" prefHeight="40.0"
                            mnemonicParsing="false" onAction="#handleNavigateToReviewSelfEvaluationAction" styleClass="secondary-button" text="Revisar Autoevaluaciones"
                            visible="false" managed="false"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>