<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.PrioritizeProjectsController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="GENERAL"/>
    <Label styleClass="content-title" text="Postulaciones"/>
    <Label styleClass="content-subtitle"
           text="Ordena los proyectos disponibles del que más te interesa al que menos."/>

    <!-- Estado: el practicante ya tiene un proyecto asignado -->
    <VBox fx:id="assignedStateContainer" managed="false" visible="false" spacing="10.0" styleClass="content-card">
        <VBox.margin>
            <Insets top="22.0"/>
        </VBox.margin>

        <Label styleClass="card-title" text="Ya tienes un proyecto asignado"/>
        <Label fx:id="assignedProjectNameLabel" styleClass="card-subtitle" text=""/>
        <Label styleClass="card-subtitle" wrapText="true"
               text="Tu postulación ya fue procesada. Consulta los detalles de tu proyecto en la sección Mi proyecto."/>
        <HBox>
            <VBox.margin>
                <Insets top="6.0"/>
            </VBox.margin>
            <Button onAction="#handleGoToAssignedProjectAction" styleClass="primary-button" text="Ir a mi proyecto"/>
        </HBox>
    </VBox>

    <!-- Estado: el practicante prioriza los proyectos disponibles -->
    <VBox fx:id="prioritizationContainer" spacing="0.0" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>

        <HBox spacing="15.0" VBox.vgrow="ALWAYS">
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label styleClass="section-label" text="Proyectos disponibles"/>
                <ListView fx:id="availableProjectsListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox alignment="CENTER" spacing="15.0">
                <Button fx:id="assignProjectButton" mnemonicParsing="false" onAction="#handleAssignProjectAction"
                        styleClass="primary-button" text="Agregar →"/>
                <Button fx:id="revokeProjectButton" mnemonicParsing="false" onAction="#handleRevokeProjectAction"
                        styleClass="secondary-button" text="← Remover"/>
            </VBox>

            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label styleClass="section-label" text="Tus prioridades (1 = mayor interés)"/>
                <ListView fx:id="prioritizedProjectsListView" VBox.vgrow="ALWAYS"/>
            </VBox>

            <VBox alignment="CENTER" spacing="15.0">
                <Button fx:id="movePriorityUpButton" mnemonicParsing="false" onAction="#handleMovePriorityUpAction"
                        styleClass="secondary-button" text="Subir"/>
                <Button fx:id="movePriorityDownButton" mnemonicParsing="false" onAction="#handleMovePriorityDownAction"
                        styleClass="secondary-button" text="Bajar"/>
            </VBox>
        </HBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <padding>
                <Insets top="18.0"/>
            </padding>
            <Button fx:id="cancelPostulationButton" mnemonicParsing="false" onAction="#handleCancelPostulationAction"
                    styleClass="secondary-button" text="Restablecer"/>
            <Button fx:id="savePostulationButton" mnemonicParsing="false" onAction="#handleSavePostulationAction"
                    styleClass="primary-button" text="Guardar postulación"/>
        </HBox>
    </VBox>
</VBox>
