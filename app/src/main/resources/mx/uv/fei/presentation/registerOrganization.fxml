<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import mx.uv.fei.presentation.components.FormField?>

<VBox alignment="TOP_CENTER" spacing="20.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.coordinator.RegisterOrganizationController">
    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="40.0" />
    </padding>

    <Label text="Registrar Nueva Organización" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
    <Label text="Llene los datos para vincular una nueva organización al sistema." style="-fx-font-size: 14px; -fx-text-fill: #666666;" />

    <VBox spacing="15.0" alignment="CENTER" maxWidth="500.0">
        <FormField fx:id="fieldName" promptText="Nombre de la Organización" />
        <FormField fx:id="fieldBusiness" promptText="Sector (Ej. Tecnología, Educación)" />
        <FormField fx:id="fieldAddress" promptText="Dirección Física" />
        <FormField fx:id="fieldCity" promptText="Ciudad" />
        <FormField fx:id="fieldMail" promptText="Correo Electrónico Oficial" />
        <FormField fx:id="fieldCellphone" promptText="Teléfono de Contacto" />
    </VBox>

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleActionCancelButton" prefWidth="150.0" text="Cancelar" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleActionSaveButton" prefWidth="150.0" text="Guardar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>
</VBox>
