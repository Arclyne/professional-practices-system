<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20.0" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.PractitionerManagementController">
    <padding>
        <Insets bottom="30.0" left="50.0" right="50.0" top="40.0" />
    </padding>
    <Label text="Gestión de Practicantes" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" />
    <Label text="Seleccione un practicante para editar su información personal." style="-fx-font-size: 14px; -fx-text-fill: #666666;" />

    <ListView fx:id="practitionersListView" prefHeight="350.0" prefWidth="700.0" VBox.vgrow="ALWAYS" style="-fx-background-radius: 5; -fx-border-color: #cccccc;" />

    <HBox alignment="CENTER" spacing="20.0">
        <Button mnemonicParsing="false" onAction="#handleReturnAction" prefWidth="120.0" text="Regresar" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button mnemonicParsing="false" onAction="#handleRegisterNewPractitionerAction" prefWidth="200.0" text="Registrar Nuevo Practicante" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
        <Button mnemonicParsing="false" onAction="#handleEditSelectedAction" prefWidth="180.0" text="Editar Seleccionado" style="-fx-background-color: #F59E0B; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>
</VBox>
