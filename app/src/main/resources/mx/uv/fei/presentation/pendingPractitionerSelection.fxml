<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.PendingPractitionerSelectionController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="GESTIÓN"/>
    <Label styleClass="content-title" text="Asignar proyectos"/>
    <Label styleClass="content-subtitle"
           text="Selecciona un practicante pendiente para revisar sus proyectos priorizados y asignarle uno."/>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>
        <Label styleClass="section-label" text="Practicantes pendientes de asignación"/>
        <ListView fx:id="pendingPractitionersListView" VBox.vgrow="ALWAYS"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <padding>
            <Insets top="18.0"/>
        </padding>
        <Button fx:id="refreshPractitionersButton" mnemonicParsing="false" onAction="#handleRefreshAction"
                styleClass="secondary-button" text="Refrescar"/>
        <Button fx:id="reviewPractitionerPostulationsButton" mnemonicParsing="false"
                onAction="#handleReviewPractitionerPostulationsAction" styleClass="primary-button"
                text="Revisar postulaciones"/>
    </HBox>
</VBox>
