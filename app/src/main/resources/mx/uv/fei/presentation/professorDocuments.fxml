<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.professor.ProfessorDocumentsController">

    <VBox prefWidth="320.0" spacing="12.0"
          style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
        <padding><Insets bottom="24.0" left="20.0" right="20.0" top="24.0"/></padding>

        <Label styleClass="form-title" text="Revisión de Documentos"/>
        <Label textFill="#6b7280" wrapText="true"
               text="Selecciona un practicante para revisar sus documentos iniciales y finales."/>

        <ListView fx:id="practitionersListView" VBox.vgrow="ALWAYS"
                  style="-fx-border-color: #E5E7EB; -fx-border-radius: 5px;"/>

        <Label fx:id="noPractitionersLabel" managed="false" textFill="#6b7280" visible="false" wrapText="true"
               text="No tienes practicantes asignados en este periodo."/>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <VBox fx:id="reviewContainer" managed="false" spacing="14.0" visible="false" HBox.hgrow="ALWAYS">
        <padding><Insets bottom="26.0" left="28.0" right="28.0" top="26.0"/></padding>

        <Label fx:id="selectedPractitionerLabel" styleClass="form-title"/>

        <TableView fx:id="documentsTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="typeColumn" prefWidth="180.0" text="Tipo"/>
                <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Archivo"/>
                <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Estado"/>
                <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Subido"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <TextField fx:id="rejectReasonTextField" promptText="Motivo de rechazo (obligatorio para rechazar)"
                       HBox.hgrow="ALWAYS"/>
            <Button onAction="#handleViewFileAction" styleClass="secondary-button" text="Ver archivo"/>
            <Button onAction="#handleAcceptAction" styleClass="primary-button" text="Aceptar"/>
            <Button onAction="#handleRejectAction" styleClass="secondary-button" text="Rechazar"/>
        </HBox>
    </VBox>
</HBox>
