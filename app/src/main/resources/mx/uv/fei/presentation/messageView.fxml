<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #FFFFFF;"
            stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.fei.presentation.shared.MessageController">

    <left>
        <VBox prefWidth="210.0" spacing="8.0" style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>

            <Label text="Mensajería" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 14px;" />
            <Separator opacity="0.5" />

            <Button fx:id="inboxNavigationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    styleClass="secondary-button" text="Bandeja de Entrada" />

            <Button fx:id="sentNavigationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    styleClass="secondary-button" text="Mensajes Enviados" />

            <Button fx:id="composeNavigationButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    styleClass="secondary-button" text="Redactar Mensaje" />
        </VBox>
    </left>

    <center>
        <StackPane>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <VBox fx:id="inboxContainer" spacing="15.0" visible="true" managed="true">
                <HBox alignment="CENTER_LEFT" prefHeight="45.0" style="-fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="10.0" />
                    </padding>
                    <Label fx:id="inboxTitleLabel" styleClass="form-title" text="Bandeja de Entrada" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                    <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                        <Button fx:id="refreshButton" mnemonicParsing="false" styleClass="secondary-button" text="Actualizar" />
                    </HBox>
                </HBox>

                <TableView fx:id="messagesTableView" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6px; -fx-border-radius: 6px;">
                    <columns>
                        <TableColumn fx:id="senderTableColumn" minWidth="150.0" prefWidth="200.0" text="Remitente" />
                        <TableColumn fx:id="subjectTableColumn" minWidth="250.0" prefWidth="450.0" text="Asunto" />
                        <TableColumn fx:id="dateTableColumn" minWidth="120.0" prefWidth="150.0" text="Fecha" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <VBox fx:id="composeContainer" spacing="15.0" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" prefHeight="45.0" style="-fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="10.0" />
                    </padding>
                    <Label styleClass="form-title" text="Nuevo Mensaje institucional" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                </HBox>

                <VBox spacing="5.0">
                    <Label text="Correo del Destinatario:" styleClass="field-label" />
                    <TextField fx:id="receiverEmailTextField" promptText="ejemplo@uv.mx o alumno@estudiantes.uv.mx" />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Asunto:" styleClass="field-label" />
                    <TextField fx:id="subjectTextField" promptText="Asunto de las Prácticas Profesionales..." />
                </VBox>

                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <Label text="Cuerpo del Mensaje:" styleClass="field-label" />
                    <TextArea fx:id="bodyTextArea" promptText="Escribe el contenido de tu mensaje aquí..." wrapText="true" VBox.vgrow="ALWAYS" />
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button fx:id="sendMessageButton" mnemonicParsing="false" styleClass="primary-button" text="Enviar Mensaje" />
                </HBox>
            </VBox>

            <VBox fx:id="readContainer" spacing="15.0" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" prefHeight="45.0" style="-fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="10.0" />
                    </padding>
                    <Button fx:id="backToInboxButton" mnemonicParsing="false" styleClass="secondary-button" text="← Volver a la Bandeja" />
                </HBox>

                <VBox spacing="6.0" style="-fx-background-color: #F9FAFB; -fx-padding: 15px; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px;">
                    <Label fx:id="readSubjectLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Asunto del correo" />
                    <Label fx:id="readSenderLabel" style="-fx-font-size: 13px; -fx-text-fill: #4B5563;" text="De: Remitente" />
                    <Label fx:id="readDateLabel" style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;" text="Fecha: 00/00/0000 00:00" />
                </VBox>

                <TextArea fx:id="readBodyTextArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                          style="-fx-font-size: 14px; -fx-background-color: transparent; -fx-border-color: #E5E7EB; -fx-border-radius: 4px;" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>