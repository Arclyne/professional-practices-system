<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.practitioner.PractitionerHomeController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="PRACTICANTE"/>
    <Label fx:id="greetingLabel" styleClass="content-title" text="Hola"/>
    <Label styleClass="content-subtitle" text="Consulta tu avance y entregables desde el menú lateral."/>

    <Label fx:id="statusBannerLabel" styleClass="status-pill" wrapText="true" visible="false" managed="false">
        <VBox.margin>
            <Insets top="12.0"/>
        </VBox.margin>
    </Label>

    <HBox spacing="16.0">
        <VBox.margin>
            <Insets top="22.0"/>
        </VBox.margin>

        <VBox prefWidth="280.0" spacing="4.0" styleClass="content-card">
            <Label styleClass="card-eyebrow" text="HORAS ACUMULADAS"/>
            <Label fx:id="accumulatedHoursLabel" styleClass="card-title" text="—"/>
            <Label styleClass="card-subtitle" text="de 420 h requeridas"/>
        </VBox>
    </HBox>

    <HBox spacing="16.0">
        <VBox.margin>
            <Insets top="16.0"/>
        </VBox.margin>

        <VBox prefWidth="280.0" spacing="4.0" styleClass="content-card">
            <Label styleClass="card-eyebrow" text="SECCIÓN (NRC)"/>
            <Label fx:id="sectionLabel" styleClass="card-title" text="—"/>
            <Label styleClass="card-subtitle" text="Grupo de prácticas en el que estás inscrito."/>
        </VBox>

        <VBox prefWidth="320.0" spacing="4.0" styleClass="content-card">
            <Label styleClass="card-eyebrow" text="PROFESOR A CARGO"/>
            <Label fx:id="professorLabel" styleClass="card-title" text="—"/>
            <Label styleClass="card-subtitle" text="Académico responsable de tu sección."/>
        </VBox>
    </HBox>
</VBox>
