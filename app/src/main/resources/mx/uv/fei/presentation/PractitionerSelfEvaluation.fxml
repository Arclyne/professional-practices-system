<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.PractitionerSelfEvaluationController">

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Button mnemonicParsing="false" onAction="#handleReturnToMenu"
                text="← Regresar"
                style="-fx-background-color: #E0E0E0; -fx-cursor: hand;"/>
        <Label text="PRAIS-03: Autoevaluación Final">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0"
          style="-fx-background-color: #F5F5F5; -fx-padding: 10;">
        <Label fx:id="statusLabel" text="Estado: Verificando requisitos..."
               textFill="#d32f2f"
               style="-fx-padding: 0 0 0 10;">
            <font><Font name="System Bold" size="13.0"/></font>
        </Label>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;">
        <VBox spacing="12.0" style="-fx-padding: 10;">

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="1. Mi participación en la Organización Vinculada fue productiva."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q1ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="2. Logré la aplicación de los conocimientos teórico-prácticos."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q2ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="3. Me sentí seguro al realizar las actividades encomendadas."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q3ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="4. Las actividades encomendadas despertaron mi interés."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q4ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="5. La Organización Vinculada me proporcionó información y facilidades."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q5ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="6. La Organización Vinculada me dio a conocer las reglas internas."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q6ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="7. El Responsable del Proyecto me orientó correctamente."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q7ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="8. El Responsable del Proyecto realizó un seguimiento efectivo."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q8ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="9. El proyecto es congruente con la formación de mi carrera."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q9ComboBox" prefWidth="70"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label prefWidth="550" wrapText="true"
                       text="10. Considero que las prácticas son importantes para mi formación."/>
                <Region HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="q10ComboBox" prefWidth="70"/>
            </HBox>

        </VBox>
    </ScrollPane>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button fx:id="saveButton" onAction="#handleSaveEvaluation"
                text="Guardar Respuestas"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button fx:id="downloadPdfButton" onAction="#handleDownloadPdf"
                text="Descargar PRAIS-03"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-cursor: hand;"/>
        <Button fx:id="uploadSignedButton" onAction="#handleUploadSignedPdf"
                text="Subir PDF Firmado"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-cursor: hand;"/>
    </HBox>
</VBox>
