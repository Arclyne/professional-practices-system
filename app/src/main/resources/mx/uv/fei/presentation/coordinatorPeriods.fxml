<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.coordinator.CoordinatorPeriodsController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="INSTITUCIONAL"/>
    <Label styleClass="content-title" text="Periodos académicos"/>
    <Label styleClass="content-subtitle" text="Administra el periodo en turno y el historial de periodos académicos."/>

    <VBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>

        <VBox fx:id="activePeriodCard" spacing="8.0" styleClass="content-card active-card">
            <Label styleClass="card-eyebrow" text="PERIODO ACTIVO"/>
            <Label fx:id="activePeriodNameLabel" styleClass="card-title" text="—"/>
            <Label fx:id="activePeriodMetaLabel" styleClass="card-subtitle" text="—"/>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <Label fx:id="activePeriodStatusLabel" styleClass="status-pill" text="—"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#handleInactivateAction" styleClass="secondary-button" text="Concluir"/>
            </HBox>
        </VBox>

        <Label fx:id="noActivePeriodLabel" managed="false" styleClass="content-card empty-card" visible="false"
               text="No hay periodo activo. Registra uno nuevo o activa uno del historial."/>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label styleClass="section-label" text="Periodos"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="activateButton" onAction="#handleActivateSelectedAction" styleClass="secondary-button"
                    text="Activar seleccionado"/>
            <Button onAction="#handleEditSelectedAction" styleClass="secondary-button" text="Editar seleccionado"/>
            <Button fx:id="registerButton" onAction="#handleRegisterAction" styleClass="primary-button"
                    text="+ Registrar periodo"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <TextField fx:id="searchTextField" onKeyReleased="#handleSearchAction" HBox.hgrow="ALWAYS"
                       promptText="Buscar por nombre del periodo"/>
            <ComboBox fx:id="statusFilterComboBox" onAction="#handleFilterAction" prefWidth="170.0"/>
            <Button onAction="#handleRefreshAction" styleClass="secondary-button" text="Refrescar"/>
        </HBox>

        <TableView fx:id="periodsTableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="280.0" text="Periodo"/>
                <TableColumn fx:id="startColumn" prefWidth="140.0" text="Inicio"/>
                <TableColumn fx:id="endColumn" prefWidth="140.0" text="Fin"/>
                <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Estado"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
