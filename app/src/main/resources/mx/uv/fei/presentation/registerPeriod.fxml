<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import mx.uv.fei.presentation.components.FormField?>

<AnchorPane prefHeight="550.0" prefWidth="450.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.RegisterPeriodController">
    <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">

        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <Label styleClass="form-title" text="Registrar Nuevo Periodo"/>

        <Label text="Ingrese la información y fechas del periodo académico." textFill="#6b7280">
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <FormField fx:id="fieldPeriodName" labelText="Nombre del Periodo:" promptText="Ej. Febrero - Julio 2026"/>

        <VBox spacing="5.0">
            <Label text="Fecha de Inicio:"/>
            <DatePicker fx:id="startDatePicker" maxWidth="1.7976931348623157E308" promptText="Seleccione la fecha de inicio"/>
        </VBox>

        <VBox spacing="5.0">
            <Label text="Fecha de Fin:"/>
            <DatePicker fx:id="endDatePicker" maxWidth="1.7976931348623157E308" promptText="Seleccione la fecha de fin"/>
        </VBox>

        <HBox spacing="15.0">
            <VBox.margin>
                <Insets top="30.0"/>
            </VBox.margin>

            <Button fx:id="cancelButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleActionCancelButton" styleClass="secondary-button" text="Cancelar" HBox.hgrow="ALWAYS"/>

            <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleActionSaveButton" styleClass="primary-button" text="Guardar Periodo" HBox.hgrow="ALWAYS"/>
        </HBox>

    </VBox>
</AnchorPane>