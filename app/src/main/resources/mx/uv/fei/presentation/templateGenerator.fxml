<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.TemplateGeneratorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="form-title" text="Generador de Plantillas (Coordinación)" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Selecciona un tipo de documento y haz doble clic en las piezas para ensamblarlo." textFill="#6b7280" />

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" prefWidth="250.0">
            <Label text="1. Tipo de Documento:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="documentTypeComboBox" maxWidth="1.7976931348623157E308" />

            <Label text="2. Piezas Disponibles:" style="-fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
            <ListView fx:id="templatePartsListView" VBox.vgrow="ALWAYS" />

            <Button mnemonicParsing="false" onAction="#handleInsertSelectedPart" text="Insertar Pieza Seleccionada" maxWidth="1.7976931348623157E308"/>
        </VBox>

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Previsualización del Documento:" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="documentPreviewTextArea" VBox.vgrow="ALWAYS" promptText="El contenido del documento aparecerá aquí..." />

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button mnemonicParsing="false" onAction="#handleClear" text="Limpiar Todo" style="-fx-text-fill: #EF4444;" />
                <Button mnemonicParsing="false" onAction="#handleSaveDocument" text="Generar y Guardar Documento" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold;" />
            </HBox>
        </VBox>
    </HBox>
</VBox>