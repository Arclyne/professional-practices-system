<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@../styles.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.fei.presentation.professor.ProfessorEvaluateReportController">

    <HBox spacing="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="10.0" prefWidth="380.0"
              style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="24.0" left="20.0" right="20.0" top="24.0"/></padding>

            <Label styleClass="form-title" text="Reportes Entregados"/>
            <Label textFill="#6b7280" wrapText="true"
                   text="Todos los reportes enviados por los practicantes: Mensuales, Intermedios (210h) y Finales (420h)."/>

            <HBox spacing="16.0">
                <Label text="Evaluado" style="-fx-text-fill: #10B981; -fx-font-size: 11px;"/>
                <Label text="Pendiente" style="-fx-text-fill: #F59E0B; -fx-font-size: 11px;"/>
            </HBox>

            <Label text="Buscar por matrícula" styleClass="field-label"/>
            <TextField fx:id="searchTextField" onKeyReleased="#handleSearchAction"
                       promptText="Ej. zS20013412" maxWidth="1.7976931348623157E308"/>

            <Label text="Filtrar por grupo" styleClass="field-label"/>
            <ComboBox fx:id="groupFilterComboBox" onAction="#handleGroupFilterAction"
                      maxWidth="1.7976931348623157E308"/>

            <Label text="Filtrar por estado" styleClass="field-label"/>
            <ComboBox fx:id="statusFilterComboBox" onAction="#handleStatusFilterAction"
                      maxWidth="1.7976931348623157E308"/>

            <ListView fx:id="reportsListView" VBox.vgrow="ALWAYS"
                      style="-fx-border-color: #E5E7EB; -fx-background-radius: 5px; -fx-border-radius: 5px;"/>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <VBox fx:id="evaluationContainer" spacing="14.0" HBox.hgrow="ALWAYS"
              visible="false" managed="false">
            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></padding>

            <Label styleClass="form-title" text="Panel de Evaluación"/>

            <Label fx:id="labelReportKind"
                   text="Tipo de reporte: —"
                   style="-fx-background-color: #DBEAFE; -fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-background-radius: 20px; -fx-padding: 4 12 4 12; -fx-font-size: 12px;"/>

            <Label fx:id="labelReportInfo" text="..."
                   style="-fx-font-size: 13px; -fx-text-fill: #374151; -fx-background-color: #FFFFFF; -fx-padding: 10px; -fx-border-color: #D1D5DB; -fx-border-radius: 5px;"
                   maxWidth="1.7976931348623157E308" wrapText="true"/>

            <Button fx:id="btnViewPdf" mnemonicParsing="false" onAction="#handleViewPdfAction"
                    text="Abrir PDF Firmado (Evidencia)"
                    style="-fx-background-color: transparent; -fx-border-color: #3B82F6; -fx-text-fill: #3B82F6; -fx-border-radius: 5px; -fx-cursor: hand;"/>

            <Separator/>

            <VBox spacing="5.0">
                <Label text="Calificación (0.0 – 10.0) *" styleClass="field-label"/>
                <TextField fx:id="fieldGrade" promptText="Ej. 9.5" maxWidth="150.0"/>
            </VBox>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Label text="Retroalimentación al Practicante *" styleClass="field-label"/>
                <TextArea fx:id="areaFeedback"
                          promptText="Escribe tus comentarios, correcciones o felicitaciones aquí..."
                          wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnSaveEvaluation" maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false" onAction="#handleSaveEvaluationAction"
                    text="Guardar Evaluación"
                    style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-cursor: hand; -fx-padding: 10 20 10 20;"/>
        </VBox>
    </HBox>
</AnchorPane>
