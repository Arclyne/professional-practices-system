<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.practitioner.ProgressReportGeneratorController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="ENTREGABLES"/>
    <Label styleClass="content-title" text="Reporte de avance"/>
    <Label styleClass="content-subtitle" wrapText="true"
           text="Primero el reporte Intermedio (≥ 210 horas); cuando el profesor lo evalúe se habilita el Final (≥ 420 horas)."/>

    <VBox spacing="10.0" styleClass="content-card">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>
        <Label styleClass="content-card-title" text="Reporte Intermedio"/>
        <Label fx:id="intermediateStatusLabel" styleClass="card-subtitle" wrapText="true" text="..."/>
        <Label fx:id="intermediateGradeLabel" style="-fx-font-weight: bold; -fx-text-fill: #10B981;" text=""/>
        <TextArea fx:id="intermediateFeedbackArea" editable="false" wrapText="true" maxHeight="80.0" text=""/>

        <VBox fx:id="intermediateDateContainer" spacing="6.0">
            <VBox.margin>
                <Insets top="4.0"/>
            </VBox.margin>
            <Label styleClass="section-label" text="Fecha de corte del reporte intermedio"/>
            <DatePicker fx:id="periodEndDatePicker" maxWidth="300.0"/>
        </VBox>

        <Button fx:id="generateReportButton" onAction="#handleGenerateReport" maxWidth="1.7976931348623157E308"
                styleClass="primary-button" text="Generar reporte Intermedio"/>

        <HBox spacing="10.0">
            <VBox.margin>
                <Insets top="4.0"/>
            </VBox.margin>
            <Button fx:id="intermediateDownloadButton" onAction="#handleDownloadIntermediate"
                    styleClass="secondary-button" text="Descargar PDF"/>
            <Button fx:id="intermediateUploadButton" onAction="#handleUploadIntermediate"
                    styleClass="primary-button" text="Subir PDF firmado"/>
            <Button fx:id="intermediateViewButton" onAction="#handleViewIntermediate"
                    styleClass="secondary-button" text="Ver archivo entregado"/>
        </HBox>
    </VBox>

    <VBox spacing="10.0" styleClass="content-card">
        <VBox.margin>
            <Insets top="16.0"/>
        </VBox.margin>
        <Label styleClass="content-card-title" text="Reporte Final"/>
        <Label fx:id="finalLockedLabel" styleClass="card-subtitle" wrapText="true"
               text="Disponible cuando tu reporte Intermedio sea aprobado por el profesor."/>
        <Label fx:id="finalStatusLabel" styleClass="card-subtitle" wrapText="true" text="..."/>
        <Label fx:id="finalGradeLabel" style="-fx-font-weight: bold; -fx-text-fill: #10B981;" text=""/>
        <TextArea fx:id="finalFeedbackArea" editable="false" wrapText="true" maxHeight="80.0" text=""/>

        <Button fx:id="finalGenerateButton" onAction="#handleGenerateFinalReport" maxWidth="1.7976931348623157E308"
                styleClass="primary-button" text="Generar reporte Final"/>

        <HBox spacing="10.0">
            <VBox.margin>
                <Insets top="4.0"/>
            </VBox.margin>
            <Button fx:id="finalDownloadButton" onAction="#handleDownloadFinal"
                    styleClass="secondary-button" text="Descargar PDF"/>
            <Button fx:id="finalUploadButton" onAction="#handleUploadFinal"
                    styleClass="primary-button" text="Subir PDF firmado"/>
            <Button fx:id="finalViewButton" onAction="#handleViewFinal"
                    styleClass="secondary-button" text="Ver archivo entregado"/>
        </HBox>
    </VBox>
</VBox>
