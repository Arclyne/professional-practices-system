<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.PractitionerDocumentsController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label styleClass="content-eyebrow" text="ENTREGABLES"/>
            <Label styleClass="content-title" text="Mis documentos"/>
        </VBox>
        <Button onAction="#handleUploadAction" styleClass="primary-button" text="+ Subir documento"/>
    </HBox>

    <Label text="Sube los documentos requeridos para tu expediente. Puedes subir varios archivos aunque tengan el mismo nombre."
           textFill="#6b7280" wrapText="true">
        <VBox.margin>
            <Insets top="6.0"/>
        </VBox.margin>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>
        <Region HBox.hgrow="ALWAYS"/>
        <Button onAction="#handleViewFileAction" styleClass="secondary-button" text="Ver archivo"/>
        <Button onAction="#handleRefreshAction" styleClass="secondary-button" text="Refrescar"/>
    </HBox>

    <TableView fx:id="documentsTableView" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="12.0"/>
        </VBox.margin>
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="360.0" text="Documento"/>
            <TableColumn fx:id="statusColumn" prefWidth="140.0" text="Estado"/>
            <TableColumn fx:id="dateColumn" prefWidth="180.0" text="Subido"/>
        </columns>
    </TableView>
</VBox>
