<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.PractitionerDocumentsController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label styleClass="content-eyebrow" text="ENTREGABLES"/>
            <Label styleClass="content-title" text="Documentos"/>
        </VBox>
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="14.0"/>
        </VBox.margin>
        <tabs>
            <Tab text="Iniciales">
                <VBox spacing="4.0">
                    <padding>
                        <Insets bottom="8.0" left="4.0" right="4.0" top="16.0"/>
                    </padding>

                    <Label fx:id="initialLockedLabel" managed="false" textFill="#b91c1c" visible="false" wrapText="true"/>

                    <HBox fx:id="initialActionsBox" alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Sube los documentos requeridos para iniciar tus prácticas. El profesor los revisará."
                               textFill="#6b7280" wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleViewInitialFileAction"
                                styleClass="secondary-button" text="Ver archivo"/>
                        <Button onAction="#handleUploadInitialAction"
                                styleClass="primary-button" text="+ Subir documento"/>
                    </HBox>

                    <TableView fx:id="initialDocumentsTableView" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="12.0"/>
                        </VBox.margin>
                        <columns>
                            <TableColumn fx:id="initialNameColumn" prefWidth="300.0" text="Documento"/>
                            <TableColumn fx:id="initialStatusColumn" prefWidth="120.0" text="Estado"/>
                            <TableColumn fx:id="initialCommentColumn" prefWidth="240.0" text="Observaciones"/>
                            <TableColumn fx:id="initialDateColumn" prefWidth="160.0" text="Subido"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="Finales">
                <VBox spacing="4.0">
                    <padding>
                        <Insets bottom="8.0" left="4.0" right="4.0" top="16.0"/>
                    </padding>

                    <Label fx:id="finalLockedLabel" managed="false" textFill="#b91c1c" visible="false" wrapText="true"/>

                    <HBox fx:id="finalActionsBox" alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="Sube tu carta de liberación y demás documentos finales. El profesor los revisará."
                               textFill="#6b7280" wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#handleViewFinalFileAction"
                                styleClass="secondary-button" text="Ver archivo"/>
                        <Button onAction="#handleUploadFinalAction"
                                styleClass="primary-button" text="+ Subir documento"/>
                    </HBox>

                    <TableView fx:id="finalDocumentsTableView" VBox.vgrow="ALWAYS">
                        <VBox.margin>
                            <Insets top="12.0"/>
                        </VBox.margin>
                        <columns>
                            <TableColumn fx:id="finalNameColumn" prefWidth="300.0" text="Documento"/>
                            <TableColumn fx:id="finalStatusColumn" prefWidth="120.0" text="Estado"/>
                            <TableColumn fx:id="finalCommentColumn" prefWidth="240.0" text="Observaciones"/>
                            <TableColumn fx:id="finalDateColumn" prefWidth="160.0" text="Subido"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
