<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mx.uv.fei.presentation.practitioner.ViewAssignedProjectController"
            style="-fx-background-color: #FFFFFF;">

    <VBox spacing="20.0" style="-fx-background-color: #FFFFFF;">

        <padding>
            <Insets top="30.0" right="40.0" bottom="30.0" left="40.0"/>
        </padding>

        <children>

            <Label text="Mi Proyecto Asignado"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>

            <Label text="Esta es la información del proyecto en el que has sido aceptado."
                   style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>

            <Region prefHeight="10.0"/>

            <VBox spacing="16.0"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 12px; -fx-border-color: #E5E7EB; -fx-border-radius: 12px;">
                <padding>
                    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>
                <children>

                    <Label fx:id="projectNameLabel"
                           text="Nombre del Proyecto"
                           wrapText="true"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                    <HBox spacing="24.0">
                        <children>
                            <Label fx:id="projectStatusLabel"
                                   text="Estado:"
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                            <Label fx:id="projectCapacityLabel"
                                   text="Cupos:"
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                            <Label fx:id="projectPeriodLabel"
                                   text="Periodo:"
                                   style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                        </children>
                    </HBox>

                    <Region prefHeight="4.0"/>

                    <Label text="Descripción"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>

                    <TextArea fx:id="projectDescriptionTextArea"
                              editable="false"
                              wrapText="true"
                              prefRowCount="6"
                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 8px; -fx-border-color: #D1D5DB; -fx-border-radius: 8px;"/>

                </children>
            </VBox>

            <VBox spacing="10.0"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 12px; -fx-border-color: #E5E7EB; -fx-border-radius: 12px;">
                <padding>
                    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>
                <children>

                    <Label text="Organización"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                    <Label fx:id="organizationNameLabel"
                           text="Nombre de la organización"
                           wrapText="true"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                    <Label fx:id="organizationCityLabel"
                           text="Ciudad:"
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    <Label fx:id="organizationAddressLabel"
                           text="Dirección:"
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    <Label fx:id="organizationBusinessLabel"
                           text="Giro:"
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>
                    <Label fx:id="organizationContactLabel"
                           text="Contacto:"
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>

                </children>
            </VBox>

            <VBox spacing="10.0"
                  style="-fx-background-color: #F9FAFB; -fx-background-radius: 12px; -fx-border-color: #E5E7EB; -fx-border-radius: 12px;">
                <padding>
                    <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
                </padding>
                <children>

                    <Label text="Encargado"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

                    <Label fx:id="managerNameLabel"
                           text="Nombre del encargado"
                           wrapText="true"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1F2937;"/>
                    <Label fx:id="managerContactLabel"
                           text="Contacto:"
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: #374151;"/>

                </children>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

        </children>
    </VBox>
</ScrollPane>
