<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.coordinator.CoordinatorOrganizationsController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label styleClass="content-eyebrow" text="GESTIÓN"/>
            <Label styleClass="content-title" text="Organizaciones"/>
        </VBox>
        <Button onAction="#handleRegisterAction" styleClass="primary-button" text="+ Registrar organización"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>
        <TextField fx:id="searchTextField" onKeyReleased="#handleSearchAction" HBox.hgrow="ALWAYS"
                   promptText="Buscar por nombre, giro o correo"/>
        <Button onAction="#handleActivateAction" styleClass="secondary-button" text="Activar"/>
        <Button onAction="#handleInactivateAction" styleClass="secondary-button" text="Inactivar"/>
        <Button onAction="#handleEditAction" styleClass="secondary-button" text="Editar"/>
        <Button onAction="#handleRefreshAction" styleClass="secondary-button" text="Refrescar"/>
    </HBox>

    <TableView fx:id="organizationsTableView" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="12.0"/>
        </VBox.margin>
        <columns>
            <TableColumn fx:id="nameColumn" prefWidth="260.0" text="Organización"/>
            <TableColumn fx:id="businessColumn" prefWidth="160.0" text="Giro"/>
            <TableColumn fx:id="emailColumn" prefWidth="220.0" text="Correo"/>
            <TableColumn fx:id="statusColumn" prefWidth="110.0" text="Estado"/>
        </columns>
    </TableView>
</VBox>
