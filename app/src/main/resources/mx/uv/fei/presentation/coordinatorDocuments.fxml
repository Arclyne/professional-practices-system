<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="4.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.CoordinatorDocumentsController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
            <Label styleClass="content-eyebrow" text="SEGUIMIENTO"/>
            <Label styleClass="content-title" text="Documentos de practicantes"/>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>
        <TextField fx:id="searchTextField" onKeyReleased="#handleSearchAction" HBox.hgrow="ALWAYS"
                   promptText="Filtrar por practicante o matrícula"/>
        <Button onAction="#handleViewFileAction" styleClass="secondary-button" text="Ver archivo"/>
        <Button onAction="#handleMarkReviewedAction" styleClass="primary-button" text="Marcar como revisado"/>
        <Button onAction="#handleRefreshAction" styleClass="secondary-button" text="Refrescar"/>
    </HBox>

    <TableView fx:id="documentsTableView" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="12.0"/>
        </VBox.margin>
        <columns>
            <TableColumn fx:id="practitionerColumn" prefWidth="220.0" text="Practicante"/>
            <TableColumn fx:id="enrollmentColumn" prefWidth="130.0" text="Matrícula"/>
            <TableColumn fx:id="nameColumn" prefWidth="240.0" text="Documento"/>
            <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Estado"/>
            <TableColumn fx:id="dateColumn" prefWidth="160.0" text="Subido"/>
        </columns>
    </TableView>
</VBox>
