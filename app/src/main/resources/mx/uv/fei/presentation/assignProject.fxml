<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.coordinator.AssignProjectController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="GESTIÓN"/>
    <Label styleClass="content-title" text="Asignación de proyecto"/>
    <Label fx:id="practitionerInformationLabel" styleClass="content-subtitle"
           text="Cargando información del practicante..."/>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>
        <Label styleClass="section-label" text="Proyectos priorizados (1 = mayor interés)"/>
        <ListView fx:id="practitionerPostulationsListView" VBox.vgrow="ALWAYS"/>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <padding>
            <Insets top="18.0"/>
        </padding>
        <Button fx:id="returnToDashboardButton" mnemonicParsing="false" onAction="#handleReturnToDashboardAction"
                styleClass="secondary-button" text="Volver"/>
        <Button fx:id="confirmAssignmentButton" mnemonicParsing="false" onAction="#handleConfirmAssignmentAction"
                styleClass="primary-button" text="Asignar proyecto seleccionado"/>
    </HBox>
</VBox>
