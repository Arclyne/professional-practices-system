<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.PractitionerReportsListController">
    <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
        </padding>

        <VBox spacing="15.0" prefWidth="450.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button mnemonicParsing="false" onAction="#handleReturnAction" styleClass="secondary-button" text="← Volver al Menú" />
            </HBox>
            <VBox spacing="5.0">
                <Label styleClass="form-title" text="Mis Reportes Mensuales" />
                <Label text="Selecciona un reporte de la lista para ver sus detalles y gestionar los archivos PDF." textFill="#6b7280" wrapText="true" />
            </VBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="reportsContainer" spacing="12.0">
                        <padding>
                            <Insets bottom="10.0" left="5.0" right="15.0" top="5.0"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCreateNewReportAction" styleClass="primary-button" text="＋ Crear Nuevo Reporte Mensual" />
        </VBox>

        <Separator orientation="VERTICAL" />

        <VBox fx:id="reportDetailsContainer" spacing="15.0" prefWidth="450.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #F9FAFB; -fx-padding: 25px; -fx-border-color: #E5E7EB; -fx-border-radius: 8px; -fx-background-radius: 8px;">
            <Label styleClass="form-title" text="Detalles del Reporte" />

            <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 15px; -fx-border-color: #E5E7EB; -fx-border-radius: 8px;">
                <Label fx:id="detailTitle" text="Título" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1f2937;" />
                <Label fx:id="detailPeriod" text="Fechas..." style="-fx-text-fill: #4b5563;" />
                <Label fx:id="detailStatus" text="Estado..." />
                <Label fx:id="detailGrade" text="Calificación: " style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #10B981;" />
            </VBox>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Label text="Comentarios del Profesor" styleClass="field-label" />
                <TextArea fx:id="detailFeedback" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-control-inner-background: #F3F4F6;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="10.0">
                <Button fx:id="btnDownloadPdf" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDownloadPdfAction" text="⬇ Descargar PDF para Firma" style="-fx-background-color: white; -fx-text-fill: #374151; -fx-border-color: #D1D5DB; -fx-border-radius: 5px; -fx-cursor: hand;" />

                <Button fx:id="btnUploadPdf" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUploadSignedPdfAction" styleClass="primary-button" text="⬆ Subir PDF Firmado" />

                <Button fx:id="btnViewSignedPdf" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleViewSignedPdfAction" text="📄 Ver Archivo Entregado" style="-fx-background-color: transparent; -fx-text-fill: #3B82F6; -fx-cursor: hand; -fx-underline: true;" />
            </VBox>
        </VBox>

    </HBox>
</AnchorPane>