<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="6.0" styleClass="content-root" stylesheets="@../styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mx.uv.fei.presentation.practitioner.PractitionerLogbookController">
    <padding>
        <Insets bottom="28.0" left="32.0" right="32.0" top="28.0"/>
    </padding>

    <Label styleClass="content-eyebrow" text="ENTREGABLES"/>
    <Label styleClass="content-title" text="Mis actividades"/>
    <Label styleClass="content-subtitle" text="Registra y administra las actividades de tu bitácora."/>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="18.0"/>
        </VBox.margin>

        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label styleClass="section-label" text="Bitácora"/>
            <ListView fx:id="activitiesListView" VBox.vgrow="ALWAYS"/>
            <Button fx:id="btnEditSelected" disable="true" maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false" onAction="#handleEditSelectedAction"
                    styleClass="secondary-button" text="Editar actividad seleccionada"/>
        </VBox>

        <VBox prefWidth="380.0" spacing="12.0" styleClass="content-card">
            <Label styleClass="content-card-title" text="Detalles de la actividad"/>

            <VBox spacing="5.0">
                <Label styleClass="section-label" text="Título de la actividad"/>
                <TextField fx:id="fieldTitle" promptText="Ej: Diseño de base de datos"/>
            </VBox>

            <HBox spacing="12.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-label" text="Fecha de inicio"/>
                    <DatePicker fx:id="datePickerStart" maxWidth="1.7976931348623157E308"/>
                </VBox>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-label" text="Fecha de fin"/>
                    <DatePicker fx:id="datePickerEnd" maxWidth="1.7976931348623157E308"/>
                </VBox>
            </HBox>

            <VBox spacing="5.0">
                <Label styleClass="section-label" text="Horas de duración (máx. 12 por día)"/>
                <TextField fx:id="fieldDuration" promptText="Ej: 4"/>
            </VBox>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-label" text="Descripción"/>
                <TextArea fx:id="textAreaDescription" promptText="Describe lo que realizaste..."
                          wrapText="true" VBox.vgrow="ALWAYS"/>
            </VBox>

            <Button fx:id="btnSaveActivity" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleSaveActivity" styleClass="primary-button" text="Guardar en bitácora"/>
        </VBox>
    </HBox>
</VBox>
