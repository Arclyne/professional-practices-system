<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="750.0" prefWidth="1000.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.PractitionerLogbookController">
    <HBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
        </padding>

        <VBox spacing="15.0" prefWidth="400.0" style="-fx-background-color: #F9FAFB; -fx-padding: 25px; -fx-border-color: #E5E7EB; -fx-border-radius: 8px; -fx-background-radius: 8px;">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button mnemonicParsing="false" onAction="#handleReturnAction" styleClass="secondary-button" text="← Volver" />
            </HBox>

            <Label styleClass="form-title" text="Nueva Actividad" />
            <Label text="Registra tu avance diario." textFill="#6b7280" />

            <VBox spacing="5.0">
                <Label text="Título de la Actividad (*)" styleClass="field-label" />
                <TextField fx:id="fieldTitle" promptText="Ej. Desarrollo de DAO" />
            </VBox>

            <HBox spacing="10.0">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label text="Fecha (*)" styleClass="field-label" />
                    <DatePicker fx:id="datePickerActivity" maxWidth="1.7976931348623157E308" promptText="Selecciona la fecha" />
                </VBox>
                <VBox spacing="5.0" prefWidth="100.0">
                    <Label text="Horas" styleClass="field-label" />
                    <TextField fx:id="fieldDuration" promptText="Ej. 4" />
                </VBox>
            </HBox>

            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                <Label text="Descripción (*)" styleClass="field-label" />
                <TextArea fx:id="textAreaDescription" wrapText="true" promptText="Describe qué hiciste, qué problemas encontraste..." VBox.vgrow="ALWAYS" />
            </VBox>

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSaveActivity" styleClass="primary-button" text="Guardar en Bitácora" />
        </VBox>

        <Separator orientation="VERTICAL" />

        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
            <Label styleClass="form-title" text="Mi Historial de Bitácora" />
            <Label text="Aquí aparecen todas las actividades que has registrado. Las actividades en verde están listas para ser empaquetadas en tu próximo reporte mensual." textFill="#6b7280" wrapText="true"/>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="activitiesContainer" spacing="15.0">
                        <padding>
                            <Insets bottom="10.0" left="5.0" right="15.0" top="10.0"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>

    </HBox>
</AnchorPane>