<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<GridPane fx:id="ProjectAreaGrid" hgap="15.0" vgap="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.ProjectController">
   <columnConstraints>
      <ColumnConstraints hgrow="NEVER" minWidth="90.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
      <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="20.0" vgrow="NEVER" />
      <RowConstraints minHeight="100.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
   </rowConstraints>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="projectNameTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Organización:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
      <ChoiceBox fx:id="organizationChoiceBox" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
      
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Encargado:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <ChoiceBox fx:id="managerChoiceBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Participantes (Cupo):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
      <TextField fx:id="capacityTextField" prefWidth="150.0" promptText="Ej. 10" GridPane.columnIndex="1" GridPane.rowIndex="2" />
      
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Inicio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
      <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="3">
         <children>
            <TextField fx:id="startDayTextField" prefWidth="40.0" promptText="DD" />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="/">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <TextField fx:id="startMonthTextField" prefWidth="40.0" promptText="MM" />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="/">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <TextField fx:id="startYearTextField" prefWidth="60.0" promptText="AAAA" />
         </children>
      </HBox>
      
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Termina:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
      <HBox alignment="CENTER_LEFT" spacing="5.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4">
         <children>
            <TextField fx:id="deadLineDayTextField" prefWidth="40.0" promptText="DD" />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="/">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <TextField fx:id="deadLineMonthTextField" prefWidth="40.0" promptText="MM" />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="/">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <TextField fx:id="deadLineYearTextField" prefWidth="60.0" promptText="AAAA" />
         </children>
      </HBox>
      
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
      <TextArea fx:id="descriptionTextArea" prefHeight="100.0" prefWidth="486.0" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="6" />
      
      <HBox alignment="CENTER_RIGHT" spacing="15.0" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="7">
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" text="Cancelar" />
            <Button fx:id="saveButton" mnemonicParsing="false" text="Guardar" />
         </children>
      </HBox>
   </children>
</GridPane>
