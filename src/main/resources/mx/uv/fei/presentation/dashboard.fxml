<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.fei.presentation.DashboardController">

    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0"/>
            </padding>
            <Label text="SGP - FEI" textFill="#212529">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </Label>

            <VBox spacing="5.0">
                <Label fx:id="labelUserName" text="Cargando..." textFill="#212529">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Label>
                <Label fx:id="labelUserRole" text="Rol: ..." textFill="#6c757d"/>
                <VBox.margin>
                    <Insets bottom="30.0"/>
                </VBox.margin>
            </VBox>

            <Separator opacity="0.5"/>

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;" text="Inicio" />

            <VBox fx:id="containerAdminActions" spacing="10.0">
                <Label text="Administración" textFill="#495057">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
                <Button fx:id="btnRegistrarCoordinador" maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand;"
                        text="Registrar Coordinador"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                    onAction="#handleLogout" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-cursor: hand;"
                    text="Cerrar Sesión" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="dashboardContent" style="-fx-background-color: white;">
            <VBox alignment="CENTER" spacing="20.0">
                <Label text="Bienvenido al Sistema de Gestión de Prácticas Profesionales" textFill="#212529">
                    <font>
                        <Font size="20.0"/>
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </Label>

                <VBox alignment="CENTER" spacing="15.0" maxWidth="300.0">
                    <Button fx:id="btnRegistrarPracticante" onAction="#handleRegistrarPracticante" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                            text="Registrar Practicante" prefHeight="45.0" />

                    <Button fx:id="btnRegistrarProfesor" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                            text="Registrar Profesor" prefHeight="45.0" />

                    <Button fx:id="btnRegistrarProyecto" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                            text="Registrar Proyecto" prefHeight="45.0" />

                    <Button fx:id="btnRegistrarActividad" maxWidth="1.7976931348623157E308" mnemonicParsing="false"
                            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;"
                            text="Registrar Actividad" prefHeight="45.0" />
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>