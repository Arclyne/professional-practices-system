<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Text?>

<GridPane fx:id="gridPaneConnection" hgap="15.0" vgap="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.StartSessionController">
   <columnConstraints>
      <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
      <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="30.0" vgrow="NEVER" />
      <RowConstraints minHeight="40.0" vgrow="NEVER" />
   </rowConstraints>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
      <TextField fx:id="textFieldUser" GridPane.columnIndex="1" GridPane.rowIndex="0" />
      
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
      <PasswordField fx:id="passwordFieldUser" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
      <HBox alignment="CENTER_RIGHT" spacing="15.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
         <children>
            <Button fx:id="buttonClose" mnemonicParsing="false" text="Cerrar" onAction="#handleActionCloseButton" />
            <Button fx:id="buttonConnect" mnemonicParsing="false" style="-fx-background-color: #007BFF; -fx-text-fill: white; -fx-font-weight: bold;" text="Conectar" onAction= "#handleActionConnectButton" />
         </children>
      </HBox>
   </children>
</GridPane>