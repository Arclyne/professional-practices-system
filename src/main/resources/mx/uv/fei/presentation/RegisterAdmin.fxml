<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import mx.uv.fei.presentation.components.FormComboBox?>
<?import mx.uv.fei.presentation.components.FormField?>

<AnchorPane prefHeight="650.0" prefWidth="500.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.uv.fei.presentation.RegisterAdminController">
    <VBox spacing="15.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="60.0" AnchorPane.rightAnchor="60.0"
          AnchorPane.topAnchor="40.0">

        <Label styleClass="form-title" text="Registro de Administrador"/>

        <Label text="Configure la cuenta principal de administración para el sistema FEI" textFill="#6b7280">
            <VBox.margin>
                <Insets bottom="10.0"/>
            </VBox.margin>
        </Label>

        <FormField fx:id="fieldNombre" labelText="Nombre(s)" promptText="Ingrese el nombre"/>

        <FormField fx:id="fieldApellido" labelText="Apellidos" promptText="Ingrese los apellidos"/>

        <FormField fx:id="fieldNoPersonal" labelText="Número de Personal" promptText="Ej. 12345"/>

        <FormField fx:id="fieldCorreo" labelText="Correo Electrónico" promptText="ejemplo@uv.mx"/>

        <FormField fx:id="fieldPassword" labelText="Contraseña" promptText="Cree una clave segura" />

        <FormComboBox fx:id="comboBoxSexo" labelText="Sexo / Género"/>

        <VBox VBox.vgrow="ALWAYS"/>

        <HBox spacing="15.0">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <Button fx:id="cancelButton" maxWidth="1.7976931348623157E308" onAction="#handleCancelButtonAction"
                    styleClass="secondary-button" text="Cancelar" HBox.hgrow="ALWAYS"/>
            <Button fx:id="registerButton" maxWidth="1.7976931348623157E308"
                    onAction="#handleRegisterButtonAction" styleClass="primary-button" text="Finalizar Configuración"
                    HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
</AnchorPane>