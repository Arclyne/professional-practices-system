<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import mx.uv.fei.presentation.components.FormComboBox?>
<?import mx.uv.fei.presentation.components.FormField?>
<?import javafx.scene.control.Button?>

<AnchorPane prefHeight="600.0" prefWidth="500.0" stylesheets="@../styles.css" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uv.fei.presentation.RegisterPractitionerController">
   <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
         AnchorPane.topAnchor="0.0">

      <padding>
         <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
      </padding>

      <Label styleClass="form-title" text="Registro de Practicante"/>

      <FormField fx:id="fieldStudentId" labelText="Matrícula" promptText="S200..."/>
      <FormField fx:id="fieldName" labelText="Nombre Completo" promptText="Nombre Apellido"/>
      <FormField fx:id="fieldEmail" labelText="Correo Institucional" promptText="ejemplo@estudiantes.uv.mx"/>

      <FormComboBox fx:id="comboSexo" labelText="Sexo"/>
      <FormComboBox fx:id="comboLengua" labelText="Lengua Indígena"/>

      <Button fx:id="registerButton" styleClass="primary-button" text="Registrar Practicante"
              maxWidth="1.7976931348623157E308" onAction="#handleRegisterButtonAction">
         <VBox.margin>
            <javafx.geometry.Insets top="10.0"/>
         </VBox.margin>
      </Button>

      <Button fx:id="cancelButton" styleClass="secondary-button" text="Cancelar" maxWidth="1.7976931348623157E308"
              onAction="#handleCancelButtonAction">
         <VBox.margin>
            <javafx.geometry.Insets top="5.0"/>
         </VBox.margin>
      </Button>
   </VBox>
</AnchorPane>